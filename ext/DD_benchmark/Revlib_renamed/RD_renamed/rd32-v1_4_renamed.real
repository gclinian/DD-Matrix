# Function: 1-bit adder/rd32
# Note: Embedding with constant 1
# Used Library: MCT (gates: 5, quantum costs: 13)
# This file have been taken from RevLib (www.revlib.org).
.version 1.0
.numvars 4
.variables q[0] q[1] q[2] q[3]
.inputs q[0] q[1] q[2] 1
.outputs g g q[2] q[3]
.constants ---1
.garbage ----
.begin
t3 q[1] q[0] q[3]
t2 q[0] q[1]
t3 q[2] q[1] q[3]
t1 q[3]
t2 q[1] q[2]
.end

