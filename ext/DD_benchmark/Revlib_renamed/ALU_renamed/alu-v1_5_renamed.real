# Function: alu (by Gupta et al.)
# Note: 2nd line is function output.
# a and b are inputs
# c0 c1 c2 define the function (f) as follows:
#  0  0  0 -> constant 1
#  0  0  1 -> a OR b
#  0  1  0 -> -a OR -b
#  0  1  1 -> (a AND -b) OR (-a AND b)
#  1  0  0 -> (a AND b) OR (-a AND -b)
#  1  0  1 -> a AND b
#  1  1  0 -> -a AND -b
#  1  1  1 -> constant 0
# Used Library: MCT (gates: 7  quantum costs: 15)
# This file have been taken from RevLib (www.revlib.org). 
.version 1.0
.numvars 5
.variables q[0] q[1] q[2] q[3] q[4]
.inputs c0 c1 c2 q[0] q[1]
.outputs g f g g g
.constants -----
.garbage 1-111
.begin
t2 q[4] q[3]
t2 q[1] q[2]
t2 q[2] q[4]
t3 q[4] q[2] q[1]
t2 q[1] q[0]
t3 q[0] q[3] q[1]
t1 q[1]
.end
