# A reversible ternary counter with bit-width 5
# Used Library: MCT (gates: 25, quantum costs: 65)
# This file have been taken from RevLib (www.revlib.org). 
.version 1.0
.numvars 16
.variables q[0] q[1] q[2] q[3] q[4] q[5] q[6] q[7] q[8] q[9] q[10] q[11] q[12] q[13] q[14] q[15]
.inputs 0 y4 q[11] 0 y3 q[12] 0 y2 q[13] 0 y1 q[14] 0 cnt y0 q[15]
.outputs cout y4 q[11] g y3 q[12] g y2 q[13] g y1 q[14] g g y0 q[15]
.constants 0--0--0--0--0---
.garbage ---1--1--1--11--
.begin
# bit position 0
t2 q[12] q[15]
t3 q[14] q[13] q[12]
t2 q[12] q[15]
t3 q[15] q[13] q[14]
t2 q[13] q[15]
# bit position 1
t2 q[9] q[11]
t3 q[10] q[12] q[9]
t2 q[9] q[11]
t3 q[11] q[12] q[10]
t2 q[12] q[11]
# bit position 2
t2 q[6] q[8]
t3 q[7] q[9] q[6]
t2 q[6] q[8]
t3 q[8] q[9] q[7]
t2 q[9] q[8]
# bit position 3
t2 q[3] q[5]
t3 q[4] q[6] q[3]
t2 q[3] q[5]
t3 q[5] q[6] q[4]
t2 q[6] q[5]
# bit position 4
t2 q[0] q[2]
t3 q[1] q[3] q[0]
t2 q[0] q[2]
t3 q[2] q[3] q[1]
t2 q[3] q[2]
.end
